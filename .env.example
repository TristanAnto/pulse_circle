# Pulse Circle frontend environment variables
# Copy this file to .env and adjust values as needed.
# Never commit .env — it is ignored by Git.

# Vite proxies /api to the local Express backend (default PORT 4000)
# during development, so no VITE_API_BASE_URL is required locally.
#
# Set VITE_API_BASE_URL only when the backend runs on a different host or
# port (e.g. VITE_API_BASE_URL=http://localhost:4000).
#
# Frontend environment variables are embedded in the browser bundle. Never
# put backend secrets, database credentials, or JWT secrets here.

VITE_API_BASE_URL=

# Public Nexconn App Key (safe to expose in frontend bundle — never put the
# App Secret here; the App Secret stays on the backend).
VITE_NEXCONN_APP_KEY=
