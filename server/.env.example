# Pulse Circle backend environment variables
# Copy this file to .env and fill in real values before running the server.
# Never commit .env — it is ignored by Git.

PORT=4000
NODE_ENV=development

# PostgreSQL connection string.
# Example (replace with real credentials — never hardcode secrets):
# DATABASE_URL="postgresql://pulse_circle:pulse_circle@localhost:5432/pulse_circle?schema=public"
DATABASE_URL="postgresql://pulse_circle:pulse_circle@localhost:5432/pulse_circle?schema=public"

# Comma-separated list of origins allowed to call the API from the browser.
# Must be an explicit origin; wildcard is not allowed when credentials are used.
CORS_ORIGIN="http://localhost:5173"

# JWT access token secret. Must be at least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-this-to-at-least-32-random-characters"
JWT_EXPIRES_IN="7d"

# Session cookie settings.
COOKIE_NAME="pulse_session"
# "true" in production (HTTPS); "false" for local development over HTTP.
COOKIE_SECURE="false"
# Lax or Strict. Never "none" unless the frontend is on a different registered domain.
COOKIE_SAME_SITE="Lax"

# Double-submit CSRF cookie name (read by frontend JS, sent as X-CSRF-Token header).
COOKIE_CSRF_NAME="pulse_csrf"

# Resend email delivery configuration.
# Resend is optional: if RESEND_API_KEY is not set, email delivery is disabled
# and invitation emails cannot be sent until it is configured.
# Generate an API key at https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"

# Verified sender email address in Resend (e.g., invites@yourdomain.com)
RESEND_FROM_EMAIL="invites@pulse-circle.example.org"

# Friendly sender name shown in the inbox
RESEND_FROM_NAME="Pulse Circle"

# Base URL of the frontend application, used to build invitation acceptance links
APP_BASE_URL="http://localhost:5173"

# Nexconn Chat API configuration.
# Nexconn is optional: if NEXCONN_APP_KEY is not set, chat features are disabled.
# Get your App Key and App Secret from the Nexconn Console (https://console.nexconn.ai).
NEXCONN_APP_KEY="your-nexconn-app-key"
NEXCONN_APP_SECRET="your-nexconn-app-secret"
NEXCONN_BASE_URL="https://api.sg-light-api.com"
