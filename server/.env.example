# Pulse Circle backend environment variables
# Copy this file to .env and fill in real values before running the server.
# Never commit .env — it is ignored by Git.

PORT=4000
NODE_ENV=development

# PostgreSQL connection string.
# Example (replace with real credentials — never hardcode secrets):
# DATABASE_URL="postgresql://pulse_circle:pulse_circle@localhost:5432/pulse_circle?schema=public"
DATABASE_URL="postgresql://pulse_circle:pulse_circle@localhost:5432/pulse_circle?schema=public"

# Comma-separated list of origins allowed to call the API from the browser.
CORS_ORIGIN="http://localhost:5173"
